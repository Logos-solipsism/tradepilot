# 内部票据密钥：必须与 Java 侧 trademall.ai.internal-secret 完全一致
INTERNAL_SECRET=change-me
# 大模型（OpenAI 兼容）；LLM_API_KEY 为空时进入 fake 模式（仅供本地开发）
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_TIMEOUT_SECONDS=30
# 会话存储：memory | redis
SESSION_BACKEND=memory
SESSION_WINDOW=20
SESSION_TTL_DAYS=7
REDIS_URL=redis://127.0.0.1:6379/0
# 商品目录上游（Java 侧 trademall）；token 为空时服务能起，但 /search 会 502（fail-closed）
AGENT_SERVICE_BASE_URL=http://127.0.0.1:18090
AGENT_SERVICE_TOKEN=
CATALOG_CACHE_TTL_SECONDS=300

# 向量召回第三路（fused3）。EMBEDDING_API_KEY 为空时自动降级为确定性哈希向量：
# 离线评估照样能跑，但哈希向量**没有语义能力**，报告里会标注"哈希降级"。
# 填上 SiliconFlow 的 key 后走 BAAI/bge-m3（该模型在平台上免费，1024 维）。
# 注意：这里的键只在真实环境变量**没有**设置时才生效，环境变量优先。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
# 维度必须与所用模型一致（bge-m3 = 1024）；哈希降级也按这个维度出向量，
# 这样换不换 key 都不会把已建好的 faiss 索引维度换掉
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30
